# =====================================================================
#  Bugie — .gitignore de la RAÍZ del repo
#  Cubre:  backend/ (ASP.NET Core) · bugie_app/ (Flutter)
#          frontend/bugie-admin/ y frontend/bugie-web/ (React + Vite)
#  Los patrones no llevan ruta fija: aplican a cualquier subcarpeta.
# =====================================================================


# ---------------------------------------------------------------------
#  SECRETOS / VARIABLES DE ENTORNO   (¡nunca subir!)
# ---------------------------------------------------------------------
.env
.env.*
# ...pero sí se suben las plantillas de ejemplo:
!.env.example
!.env.*.example

# Config local de ASP.NET con secretos
appsettings.*.local.json
secrets.json


# ---------------------------------------------------------------------
#  .NET / ASP.NET CORE   (backend/)
# ---------------------------------------------------------------------
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
publish/
*.user
*.suo
*.userprefs
*.cache
*.dll
*.pdb
.vs/
project.lock.json
packages/
*.nupkg
*.snupkg
# Logs de servidor
*.log


# ---------------------------------------------------------------------
#  FLUTTER / DART   (bugie_app/)
# ---------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
.flutter-versions
coverage/
*.iml
*.ipr
*.iws
# NO ignoramos pubspec.lock: en apps conviene versionarlo.

# Android (nativo dentro de Flutter)
.gradle/
local.properties
key.properties
*.jks
*.keystore
captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
# Generados
**/GeneratedPluginRegistrant.*
**/generated_plugin_registrant.*

# iOS / macOS (nativo)
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.framework/
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/ephemeral/
**/macos/Pods/
**/macos/Flutter/ephemeral/
**/Flutter/flutter_export_environment.sh

# Symbols
*.dSYM/


# ---------------------------------------------------------------------
#  NODE / REACT / VITE   (frontend/bugie-admin/ y frontend/bugie-web/)
# ---------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
.cache/
*.local
# NO ignoramos package-lock.json: conviene versionarlo.

# Logs de npm/yarn/pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/


# ---------------------------------------------------------------------
#  EDITORES / IDE
# ---------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~


# ---------------------------------------------------------------------
#  SISTEMA OPERATIVO
# ---------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Credenciales de Firebase (cuenta de servicio): nunca al repositorio
firebase-service-account*.json
