  // Historial GPS: particiones diarias de drivers.locationhistory, recorridos
  // consolidados (drivers.trippaths) y archivo frio en Parquet (un archivo por dia).
  "GpsArchive": {
    // Carpeta de los Parquet: locationhistory_YYYY-MM-DD.parquet (dia UTC)
    "Folder": "C:/bugie-uploads/gps-archive",
    // Dias de GPS crudo que se quedan en la base (2 = hoy y ayer, en UTC)
    "KeepDays": 2,
    // Hora UTC del job nocturno (8 = 3 am Peru)
    "RunAtHourUtc": 8,
